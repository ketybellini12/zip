{
  "name": "ai-builder",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src/",
    "lint:fix": "biome check src/ --apply",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-test-users.ts",
    "docker:build": "docker build -f docker/Dockerfile -t ai-builder:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env ai-builder:latest",
    "docker:compose:up": "docker compose -f docker/compose.prod.yml up -d",
    "docker:compose:down": "docker compose -f docker/compose.prod.yml down",
    "deploy:vercel": "vercel --prod",
    "deploy:dry": "./scripts/deploy.sh --dry-run",
    "health": "curl -sf http://localhost:3000/api/health || echo '❌ Unhealthy'",
    "postinstall": "tsx scripts/postinstall.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.30.0",
    "ioredis": "^5.3.2",
    "jose": "^5.2.0",
    "next": "^14.2.0",
    "next-auth": "^4.24.5",
    "pino": "^8.19.0",
    "postgres": "^3.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^14.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.6.0",
    "@playwright/test": "^1.42.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "drizzle-kit": "^0.20.0",
    "pino-pretty": "^10.3.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vercel": "^33.0.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}